# --- Java / Maven (backend) ---
target/
*.class
*.jar
*.war
*.ear
.mvn/wrapper/maven-wrapper.jar

# --- Node (frontend) ---
node_modules/
dist/
dist-ssr/
*.local
.vite/
# 发布脚本临时构建目录与旧版残留（deploy-frontend.ps1 中间产物）
dist-new.*/
dist_old.*/

# --- IDE ---
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
.factorypath

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- 日志与临时文件 ---
*.log
logs/
temp/
*.tmp
# 手工备份副本（含敏感信息的脚本备份禁止入库）
*.bak
*.bak-*

# --- 环境变量与敏感配置（内网连接信息不入库） ---
.env
.env.*
*.local
application-local.yml
application-private.yml

# --- 敏感凭据：启动脚本内含数据库密码，禁止入库 ---
start-backend.bat

# --- 业务数据目录（照片/备份/临时，禁止入库） ---
照片库/
照片库_tmp/
backup/
备份文件夾/
知识文档库/
temp_schema.txt

# --- 冒烟测试输出与演示二进制素材（不入库） ---
backend/smoke_*.json
demo/uploads/
demo/__pycache__/
demo/data/experts.db

# --- 构建输出残留与 Python 缓存 ---
frontend/build_out.txt
frontend/$err
frontend/$log
scripts/__pycache__/

# --- build artifacts / tool artifacts (not committed) ---
frontend/releases/
!frontend/releases/.gitkeep
backend/releases/
!backend/releases/.gitkeep
.zcode/
供应商图库/

# --- 发布脚本快照/蓝绿构建产物（不入库，需审批后手动清理） ---
.build-*/
frontend/dist-*/
*.err

# --- 业务数据目录（项目资料/附件上传，禁止入库） ---
项目资料库/

# Runtime frontend rollback metadata (outside webroot; never source)
frontend/release-metadata/

# --- 本地构建/工具目录（不入库） ---
builds/
.workbuddy/
.bdv4b.txt
temp/
